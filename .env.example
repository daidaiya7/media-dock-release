# 默认只在本机提供服务；首次初始化管理员后再配置公开 HTTPS 入口。
# 公开发行镜像，无需登录 GHCR；固定版本便于升级和回退。
MEDIADOCK_IMAGE=ghcr.io/daidaiya7/mediadock:1.1.0
MEDIADOCK_PUBLIC_BASE_URL=http://127.0.0.1:59189
MEDIADOCK_REQUIRE_HTTPS=0
MEDIADOCK_ADMIN_USERNAME=admin
MEDIADOCK_TIMEZONE=Asia/Shanghai
MEDIADOCK_NEXTEMBY_URL=https://nextemby.example.com
# 反向代理的实际连接 IP；多个用逗号分隔。不要使用 *。
MEDIADOCK_TRUSTED_PROXIES=127.0.0.1
# 密码和 API Token 通过初始化页面/管理后台录入，不写在此文件。
